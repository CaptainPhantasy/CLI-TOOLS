# ---------------------------------------------------------------- color

def _tty() -> bool:
    return sys.stdout.isatty() and "NO_COLOR" not in os.environ


class C:
    on = _tty()

    @classmethod
    def _c(cls, code: str, s: str) -> str:
        return f"\033[{code}m{s}\033[0m" if cls.on else s

    @classmethod
    def frame(cls, s):  return cls._c("38;5;39", s)     # bright blue
    @classmethod
    def hero(cls, s):   return cls._c("1;38;5;135", s)  # bold purple
    @classmethod
    def title(cls, s):  return cls._c("1;38;5;15", s)   # bold white
    @classmethod
    def dim(cls, s):    return cls._c("38;5;245", s)    # grey
    @classmethod
    def key(cls, s):    return cls._c("38;5;114", s)    # green
    @classmethod
    def ok(cls, s):     return cls._c("1;38;5;114", s)  # bold green
    @classmethod
    def warn(cls, s):   return cls._c("1;38;5;214", s)  # orange
    @classmethod
    def body(cls, s):   return cls._c("38;5;252", s)    # near-white
    @classmethod
    def purple(cls, s): return cls._c("38;5;141", s)    # soft purple


ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def visible_len(s: str) -> int:
    return len(ANSI_RE.sub("", s))


def clip_ansi(s: str, maxlen: int) -> str:
    """Truncate to maxlen visible chars, preserving ANSI codes."""
    if visible_len(s) <= maxlen:
        return s
    out, count, i = [], 0, 0
    while i < len(s) and count < maxlen:
        m = ANSI_RE.match(s, i)
        if m:
            out.append(m.group(0))
            i = m.end()
        else:
            out.append(s[i])
            count += 1
            i += 1
    out.append("\033[0m" if C.on else "")
    return "".join(out)


# ---------------------------------------------------------------- framing

def term_width() -> int:
    cols = shutil.get_terminal_size(fallback=(100, 24)).columns
    return max(74, min(cols, 100))


def frame(lines, title=None, footer=None, width=None, pad=2):
    """Render lines inside a rounded box. Lines may carry ANSI color."""
    w = width or term_width()
    inner = w - 2 - 2 * pad
    out = []

    if title:
        out.append(C.frame("╭──") + C.title(f" {title} ") +
                   C.frame("─" * max(0, w - 6 - len(title)) + "╮"))
    else:
        out.append(C.frame("╭" + "─" * (w - 2) + "╮"))

    for ln in lines:
        ln = clip_ansi(ln, inner)
        gap = inner - visible_len(ln)
        out.append(C.frame("│") + " " * pad + ln + " " * max(0, gap) +
                   " " * pad + C.frame("│"))

    if footer:
        out.append(C.frame("╰" + "─" * max(0, w - 6 - len(footer))) +
                   C.dim(f" {footer} ") + C.frame("──╯"))
    else:
        out.append(C.frame("╰" + "─" * (w - 2) + "╯"))
    return "\n".join(out)


def wrap_block(text: str, width: int):
    """Wrap multi-line text to width, preserving blank lines and indent."""
    lines = []
    for raw in text.split("\n"):
        if not raw.strip():
            lines.append("")
            continue
        indent = " " * (len(raw) - len(raw.lstrip()))
        wrapped = textwrap.wrap(
            raw.strip(), width=max(10, width - len(indent)),
            break_long_words=False, break_on_hyphens=False,
        ) or [""]
        lines.extend(indent + w for w in wrapped)
    return lines


def hero_block(width: int):
    cols = shutil.get_terminal_size(fallback=(100, 24)).columns
    wide_lines = HERO_WIDE.split("\n")
    wide_w = max(len(l) for l in wide_lines)
    if cols >= wide_w:
        hero_w, center = wide_w, max(width, wide_w)
        out = []
        for i, l in enumerate(wide_lines):
            shade = PURPLE_RAMP[min(i, len(PURPLE_RAMP) - 1)]
            colored = (f"\033[1;38;5;{shade}m{l.rstrip()}\033[0m"
                       if C.on else l.rstrip())
            out.append(" " * max(0, (center - hero_w) // 2) + colored)
    else:
        hero_lines = HERO_COMPACT.split("\n")
        hero_w = max(len(l) for l in hero_lines)
        center = width
        out = [" " * max(0, (center - hero_w) // 2) + C.hero(l.rstrip())
               for l in hero_lines]
    tag = TAGLINE
    out.append(" " * max(0, (center - len(tag)) // 2) + C.dim(tag))
    return "\n".join(out)


def stat_line(label, value, width):
    room = max(8, width - 14)
    if len(value) > room:
        value = value[: room - 1] + "…"
    return C.key(f"{label:<14}") + C.body(value)


# ---------------------------------------------------------------- config

def load_config():
    """Key/endpoint shared with qglm (~/.qglm.yaml); model is prompter's
    own — glm-4.5 with thinking disabled (supports prompt caching)."""
    cfg = {
        "endpoint": "https://api.z.ai/api/coding/paas/v4/chat/completions",
        "model": "glm-4.7-flash",
        "api_key": "",
        "timeout": 300,
    }
    # Per-user config wins; the machine-wide config is the fallback so
    # every account on this host works without its own setup.
    shared_dir = os.environ.get("QGLM_SHARED_DIR", "/usr/local/share/qglm")
    for yaml_path in (os.path.join(os.path.expanduser("~"), ".qglm.yaml"),
                      os.path.join(shared_dir, ".qglm.yaml")):
        if cfg["api_key"]:
            break
        try:
            with open(yaml_path, "r", encoding="utf-8") as fh:
                for line in fh:
                    m = re.match(r"\s*(api_key|endpoint)\s*:\s*(.+)", line)
                    if m:
                        cfg[m.group(1)] = m.group(2).strip().strip("'\"")
        except OSError:
            continue
    cfg["api_key"] = os.environ.get("QGLM_API_KEY", cfg["api_key"])
    cfg["endpoint"] = os.environ.get("QGLM_ENDPOINT", cfg["endpoint"])
    cfg["model"] = os.environ.get("PROMPTER_MODEL", cfg["model"])
    cfg["thinking"] = os.environ.get("PROMPTER_THINKING", "disabled")
    return cfg


# ---------------------------------------------------------------- bundle

def load_bundle():
    """Return (bundle_dict, source_path). Live iCloud copy wins; vendored
    snapshot beside this script is the fallback."""
    script_dir = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.environ.get("PROMPTER_SOURCE"),
        ICLOUD_SOURCE,
        os.path.join(script_dir, "prompt-source.json"),
    ]
    errors = []
    for path in candidates:
        if not path:
            continue
        try:
            with open(path, "r", encoding="utf-8") as fh:
                return json.load(fh), path
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f"{path}: {exc}")
    sys.stderr.write("prompter: no readable prompt source found\n")
    for e in errors:
        sys.stderr.write(f"  tried {e}\n")
    sys.exit(1)


def meta_target_text(bundle, target, source_path):
    if target == "system":
        return bundle["system_prompt"]
    if target == "template":
        return bundle["model_usage"]["user_message_template"]
    if target == "params":
        keys = ("temperature", "top_p", "top_k", "max_tokens",
                "response_format")
        params = {k: bundle["model_usage"][k]
                  for k in keys if k in bundle["model_usage"]}
        return json.dumps(params, indent=2)
    if target == "bundle":
        with open(source_path, "r", encoding="utf-8") as fh:
            return fh.read()
    raise KeyError(target)


# ---------------------------------------------------------------- clipboard

def clipboard_copy(text: str) -> bool:
    try:
        proc = subprocess.run(["pbcopy"], input=text.encode("utf-8"),
                              timeout=10)
        return proc.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


# ---------------------------------------------------------------- GLM call

def call_glm(cfg, messages, mu):
    """Streaming chat-completions call. Returns full response text.
    Shows a live progress line while tokens arrive."""
    payload = {
        "model": cfg["model"],
        "messages": messages,
        "temperature": mu.get("temperature", 0.1),
        "top_p": mu.get("top_p", 0.9),
        # engineering-call budget: verbose models (glm-4.7-flash) blow
        # through the bundle's 8k recommendation and truncate the JSON
        "max_tokens": max(16000, mu.get("max_tokens", 8000)),
        "stream": True,
        # glm-4.5 thinking costs ~55s/call for little gain here; the
        # param is ignored by non-thinking models like glm-4-32b
        "thinking": {"type": cfg.get("thinking", "disabled")},
    }
    req = urllib.request.Request(
        cfg["endpoint"],
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {cfg['api_key']}",
        },
    )
    chunks = []
    usage = {}
    start = time.time()
    last_draw = 0.0
    spinner = "◐◓◑◒"
    live = sys.stderr.isatty()
    try:
        with urllib.request.urlopen(req, timeout=cfg["timeout"]) as resp:
            for i, raw in enumerate(resp):
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    obj = json.loads(data)
                    delta = (obj["choices"][0]
                             .get("delta", {}).get("content") or "")
                except (json.JSONDecodeError, KeyError, IndexError):
                    continue
                if obj.get("usage"):
                    usage = obj["usage"]
                if delta:
                    chunks.append(delta)
                now = time.time()
                if live and now - last_draw >= 0.15:
                    last_draw = now
                    n = sum(len(c) for c in chunks)
                    sys.stderr.write(
                        f"\r  {spinner[i % 4]} engineering… "
                        f"{n:,} chars · {now - start:.0f}s ")
                    sys.stderr.flush()
    finally:
        if live:
            sys.stderr.write("\r" + " " * 60 + "\r")
            sys.stderr.flush()
    return "".join(chunks), time.time() - start, usage


def merge_usage(*usages):
    """Sum token usage across calls into one telemetry dict."""
    tot = {"prompt": 0, "cached": 0, "out": 0, "cache_supported": False}
    for u in usages:
        if not u:
            continue
        tot["prompt"] += u.get("prompt_tokens", 0)
        det = u.get("prompt_tokens_details")
        if det is not None:
            tot["cache_supported"] = True
            tot["cached"] += det.get("cached_tokens", 0)
        tot["out"] += u.get("completion_tokens", 0)
    return tot


