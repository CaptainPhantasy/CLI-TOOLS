# ---------------------------------------------------------------- main

META_COMMANDS = {"show", "copy", "raw", "info", "help"}


def parse_meta_target(args):
    if not args:
        return "system"
    t = args[0].lower()
    if t not in META_TARGETS:
        sys.stderr.write(
            f"prompter: unknown target '{t}' "
            f"(expected: {', '.join(META_TARGETS)})\n")
        sys.exit(2)
    return t


def parse_opts(args):
    """Split flags from task words."""
    opts, words, i = {}, [], 0
    flagmap = {"-a": "audience", "--audience": "audience",
               "-s": "sources", "--sources": "sources",
               "-c": "constraints", "--constraints": "constraints",
               "-o": "output_shape", "--output-shape": "output_shape",
               "-e": "existing", "--existing": "existing",
               "--copy": "copy"}
    while i < len(args):
        a = args[i]
        if a in flagmap:
            if i + 1 >= len(args):
                sys.stderr.write(f"prompter: {a} needs a value\n")
                sys.exit(2)
            opts[flagmap[a]] = args[i + 1]
            i += 2
        elif a == "--quick":
            opts["quick"] = True
            i += 1
        elif a == "--no-copy":
            opts["copy"] = "none"
            i += 1
        else:
            words.append(a)
            i += 1
    if opts.get("copy") not in (None, "prompt", "json", "none"):
        sys.stderr.write("prompter: --copy expects prompt|json|none\n")
        sys.exit(2)
    return opts, words


def main(argv):
    if any(a in ("-h", "--help", "help") for a in argv):
        view_help()
        return 0

    cmd = argv[0].lower() if argv else None
    if cmd in META_COMMANDS:
        bundle, source_path = load_bundle()
        rest = argv[1:]
        if cmd == "show":
            view_meta_show(bundle, parse_meta_target(rest), source_path)
        elif cmd == "copy":
            view_meta_copy(bundle, parse_meta_target(rest), source_path)
        elif cmd == "raw":
            sys.stdout.write(meta_target_text(
                bundle, parse_meta_target(rest), source_path))
            if sys.stdout.isatty():
                sys.stdout.write("\n")
        elif cmd == "info":
            view_info(bundle, source_path)
        return 0

    opts, words = parse_opts(argv)
    return view_engineer(words, opts)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
