def telemetry_line(tot, model=""):
    """One-line cache/token telemetry with real z.ai pricing."""
    if not tot["prompt"]:
        return C.dim(" telemetry unavailable (no usage in stream)")
    pct = 100.0 * tot["cached"] / tot["prompt"]
    price = PRICING.get(model.lower())
    if tot["cached"]:
        cache_part = C.ok(f'{tot["cached"]:,} cached ({pct:.0f}%)')
    elif tot["cache_supported"]:
        cache_part = C.dim("0 cached (cold)")
    else:
        cache_part = C.dim("cache n/a for this model")
    if price and price[0] == 0.0:
        note = "  →  free tier ✦"
    elif price and tot["cached"] and price[1] is not None:
        full = tot["prompt"] * price[0] + tot["out"] * price[2]
        real = ((tot["prompt"] - tot["cached"]) * price[0]
                + tot["cached"] * price[1] + tot["out"] * price[2])
        note = (f'  →  ${real / 1e6:.4f} '
                f'(cache saved {100 * (1 - real / full):.0f}%)')
    elif price:
        cost = tot["prompt"] * price[0] + tot["out"] * price[2]
        note = f'  →  ${cost / 1e6:.4f}'
    else:
        note = ""
    return (C.dim(" tokens  ") + C.body(f'{tot["prompt"]:,} in') +
            C.dim(" · ") + cache_part +
            C.dim(" · ") + C.body(f'{tot["out"]:,} out') + C.dim(note))


def parse_engineer_reply(text):
    """Extract the prompt_bundle JSON from the model reply, tolerating
    markdown fences or stray prose. Returns (bundle_or_None, cleaned)."""
    cleaned = text.strip()
    m = re.search(r"```(?:json)?\s*(.*?)```", cleaned, re.S)
    if m:
        cleaned = m.group(1).strip()
    for candidate in (cleaned, cleaned[cleaned.find("{"):]):
        if not candidate or not candidate.startswith("{"):
            continue
        try:
            obj = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            return obj.get("prompt_bundle", obj), candidate
    return None, text.strip()


# ---------------------------------------------------------------- wizard

def ask(label, hint, default):
    """One framed wizard question on the tty."""
    print(C.frame("╭──") + C.purple(f" {label} ") +
          C.frame("─" * max(0, term_width() - 6 - len(label)) + "╮"))
    print(C.frame("│  ") + C.dim(hint))
    try:
        value = input(C.frame("╰─ ") + C.key("› ")).strip()
    except EOFError:
        value = ""
    print()
    return value or default


def gather_inputs(task_words, opts):
    fields = {}
    fields["task"] = " ".join(task_words).strip() or opts.get("task", "")
    for name, _tag, hint, default in FIELDS:
        if name == "task":
            continue
        fields[name] = opts.get(name) or ""
    interactive = sys.stdin.isatty() and not opts.get("quick")
    if not fields["task"]:
        if not interactive:
            sys.stderr.write("prompter: describe the prompt you need, e.g. "
                             "prompter \"summarize legal contracts\"\n")
            sys.exit(2)
        fields["task"] = ask("task", FIELDS[0][2], "")
        if not fields["task"]:
            sys.stderr.write("prompter: a task is required\n")
            sys.exit(2)
    for name, _tag, hint, default in FIELDS:
        if name == "task" or fields[name]:
            continue
        fields[name] = (ask(name, hint, default) if interactive else default)
    return fields


def build_user_message(bundle, fields):
    template = bundle["model_usage"]["user_message_template"]
    mapping = {
        "TASK_INPUT": fields["task"],
        "AUDIENCE": fields["audience"],
        "SOURCES": fields["sources"],
        "CONSTRAINTS": fields["constraints"],
        "OUTPUT_SHAPE": fields["output_shape"],
        "EXISTING_ARTIFACTS_OR_NULL": fields.get("existing") or "null",
    }
    for tag, value in mapping.items():
        template = template.replace("{{" + tag + "}}", value)
    return template


# ---------------------------------------------------------------- views

def view_engineer(argv_words, opts):
    w = term_width()
    inner = w - 6
    bundle, source_path = load_bundle()
    cfg = load_config()

    if not cfg["api_key"]:
        print(frame(
            [C.warn(" ✘ ") + C.title("No GLM API key found"),
             "",
             C.body("Set one of:"),
             C.key("  export QGLM_API_KEY=") + C.dim("\"your-key\""),
             C.key("  api_key: ") + C.dim("… in ~/.qglm.yaml (shared "
                                          "with qglm)")],
            title="config"))
        return 1

    print()
    print(hero_block(w))
    print()
    fields = gather_inputs(argv_words, opts)

    brief = [stat_line("Task", fields["task"], inner)]
    for name in ("audience", "sources", "constraints", "output_shape"):
        brief.append(stat_line(name.replace("_", " ").capitalize(),
                               fields[name], inner))
    brief.append("")
    brief.append(stat_line("Engine", f'{cfg["model"]}  ·  temp '
                           f'{bundle["model_usage"]["temperature"]}', inner))
    print(frame(brief, title="commission",
                footer="PROMPT-ENGINEER-PRIME is on it"))
    print()

    messages = [
        {"role": "system", "content": bundle["system_prompt"]},
        {"role": "user", "content": build_user_message(bundle, fields)},
    ]
    elapsed = 0.0
    result = cleaned = reply = None
    usages = []
    # small models sometimes narrate ("I will now design…") and stop
    # before the JSON — nudge up to twice until the bundle arrives
    for round_no in range(3):
        try:
            reply, took, usage = call_glm(cfg, messages,
                                          bundle["model_usage"])
            usages.append(usage)
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", "replace")[:300]
            print(frame(
                [C.warn(" ✘ ") + C.title(f"GLM API error {exc.code}"), ""]
                + [C.dim(l) for l in wrap_block(detail, inner)],
                title="error"))
            return 1
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            print(frame([C.warn(" ✘ ") + C.title("Could not reach GLM"),
                         C.dim(str(exc))], title="error"))
            return 1
        elapsed += took
        if not reply.strip():
            print(frame([C.warn(" ✘ ") +
                         C.title("Empty reply from the model")],
                        title="error"))
            return 1
        result, cleaned = parse_engineer_reply(reply)
        if result is not None and "system_prompt" in result:
            break
        low = reply.lower()
        gate = "missing" in low and ("input" in low or "provide" in low)
        if gate or round_no == 2:
            break
        messages.append({"role": "assistant", "content": reply})
        messages.append({"role": "user", "content":
                         "Emit the complete prompt_bundle JSON object now, "
                         "per the output contract. Output the JSON only — "
                         "no prose before or after it."})

    if result is None or "system_prompt" not in result:
        # input-gate failure or free-text response — show it, copy it
        body = [C.body(l) for l in wrap_block(cleaned, inner)]
        print(frame(body, title="engineer's response",
                    footer=f"{cfg['model']} · {elapsed:.0f}s"))
        copied = clipboard_copy(cleaned)
        note = (C.ok(" ✔ ") + C.title("Response copied to clipboard")
                if copied else
                C.warn(" ✘ ") + C.title("Clipboard copy failed"))
        print(frame([note, telemetry_line(merge_usage(*usages),
                                          cfg["model"])]))
        return 0

    # ---- engineered bundle received
    saved = save_history(result)
    sp = result["system_prompt"]
    samp = result.get("sampling_parameters", {})

    head = [
        stat_line("Prompt", f'{result.get("name", "unnamed")}  '
                  f'v{result.get("version", "?")}', inner),
        stat_line("Use", result.get("intended_use", ""), inner),
        stat_line("Sampling", " · ".join(
            f"{k} {samp[k]}" for k in ("preset", "temperature", "top_p",
                                       "max_tokens") if k in samp), inner),
        stat_line("Layers", layer_summary(result), inner),
    ]
    if result.get("assumptions_to_verify"):
        head.append("")
        head.append(C.warn("Verify before deploying:"))
        for a in result["assumptions_to_verify"][:4]:
            head.extend(C.dim(l) for l in wrap_block("• " + a, inner))
    print(frame(head, title="engineered prompt",
                footer=f"{cfg['model']} · {elapsed:.0f}s"))
    print()

    body = [C.body(l) for l in wrap_block(sp, inner)]
    print(frame(body, title="system prompt",
                footer=f"{len(sp):,} chars"))
    print()

    copy_target = opts.get("copy", "prompt")
    if copy_target == "none":
        note = C.dim(" copy skipped (--copy none)")
    else:
        payload = (json.dumps({"prompt_bundle": result}, indent=2)
                   if copy_target == "json" else sp)
        label = ("full bundle JSON" if copy_target == "json"
                 else "system prompt")
        if clipboard_copy(payload):
            note = (C.ok(" ✔ ") + C.title(f"Engineered {label} copied "
                                          "to clipboard") +
                    C.dim("  —  paste it anywhere with ⌘V"))
        else:
            note = C.warn(" ✘ ") + C.title("Clipboard copy failed")
    tail = [note]
    if saved:
        tail.append(C.dim(f" full bundle saved → {saved}"))
    tail.append(C.dim(" user-message template + eval plan are in the "
                      "saved bundle (--copy json for all of it)"))
    tail.append(telemetry_line(merge_usage(*usages), cfg["model"]))
    print(frame(tail, footer="prompter --help for more"))
    print()
    return 0


def layer_summary(result):
    layers = result.get("layers_satisfied", {})
    if not layers:
        return "not reported"
    good = sum(1 for v in layers.values() if v)
    return f"{good}/{len(layers)} deterministic layers satisfied"


def save_history(result):
    try:
        os.makedirs(HISTORY_DIR, exist_ok=True)
        stamp = time.strftime("%Y%m%d-%H%M%S")
        name = re.sub(r"[^a-z0-9-]", "-",
                      str(result.get("name", "prompt")).lower())[:40]
        path = os.path.join(HISTORY_DIR, f"{stamp}-{name}.json")
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"prompt_bundle": result}, fh, indent=2)
        return path.replace(os.path.expanduser("~"), "~")
    except OSError:
        return None


