#!/usr/bin/env python3
"""SALVAGER — find the work you haven't saved yet.

Walks every git repo on this machine and reports what would vanish if the
disk died right now: uncommitted edits, unpushed commits, stashes, and
branches that exist nowhere but here. Ranked by how much you'd lose.

    salvager                   scan and rank everything at risk
    salvager --all             include clean repos in the listing
    salvager --roots A:B       scan specific roots instead of the defaults
    salvager --brief           one line per repo, no detail
    salvager explain           GLM triages the riskiest findings
    salvager --json            machine-readable, for scripts
    salvager --help            usage

Read-only by construction: SALVAGER runs no git command that writes. It
will never commit, push, stash or checkout on your behalf. The whole
point is to tell you what to save; deciding how is yours.

Zero dependencies. Config shared with qglm (~/.qglm.yaml / QGLM_API_KEY).
"""

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from clikit import (C, call_glm, clipboard_copy, frame, hero_block,  # noqa: E402
                    human_age, load_config, merge_usage, run, stat_line,
                    telemetry_line, term_width, tilde, user_homes,
                    wrap_block)

