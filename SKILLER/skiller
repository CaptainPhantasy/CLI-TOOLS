def user_homes():
    """Every real home directory on this machine, current user first.

    A global install indexes skills belonging to all accounts, not just
    whoever happens to be running the command. Homes we can't read are
    dropped silently (find/fd would just error on them anyway)."""
    homes = [HOME]
    for base in ("/Users", "/home"):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if name.startswith(".") or name == "Shared":
                continue
            p = os.path.join(base, name)
            if os.path.isdir(p) and p not in homes and os.access(p, os.R_OK):
                homes.append(p)
    return homes


def skill_roots():
    roots = []
    for home in user_homes():
        roots += [os.path.join(home, d) for d in DOT_DIRS]
    roots.append(STAGING_ROOT)
    roots += [r for r in SHARED_SKILL_DIRS if r]
    extra = os.environ.get("SKILLER_ROOTS", "")
    roots += [r for r in extra.split(":") if r]
    seen, uniq = set(), []
    for r in roots:
        if r not in seen and os.path.isdir(r):
            seen.add(r)
            uniq.append(r)
    return uniq


def find_skill_files(roots, progress=None):
    fd = shutil.which("fd")
    files = []
    for i, root in enumerate(roots):
        if progress:
            progress(f"scanning {os.path.basename(root) or root} "
                     f"({i + 1}/{len(roots)}) · {len(files):,} found")
        try:
            if fd:
                out = subprocess.run(
                    [fd, "-H", "-I", "--max-depth", "8", "-g", "SKILL.md",
                     ".", root],
                    capture_output=True, text=True, timeout=240)
            else:
                out = subprocess.run(
                    ["find", root, "-maxdepth", "8", "-name", "SKILL.md",
                     "-type", "f"],
                    capture_output=True, text=True, timeout=240)
            files.extend(l for l in out.stdout.splitlines() if l.strip())
        except (OSError, subprocess.TimeoutExpired):
            continue
    return files


FRONT_RE = re.compile(r"^---\s*\n(.*?)\n---", re.S)


def parse_skill_head(path):
    """Return (name, description) from frontmatter or content heuristics."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            head = fh.read(4096)
    except OSError:
        return None
    name = desc = ""
    m = FRONT_RE.match(head)
    if m:
        block = m.group(1)
        nm = re.search(r"^name:\s*(.+)$", block, re.M)
        if nm:
            name = nm.group(1).strip().strip("'\"")
        dm = re.search(r"^description:\s*(.*)$", block, re.M)
        if dm:
            desc = dm.group(1).strip().strip("'\"")
            if desc in ("|", ">", "|-", ">-"):
                desc_lines = []
                for line in block[dm.end():].split("\n"):
                    if line.startswith((" ", "\t")) and line.strip():
                        desc_lines.append(line.strip())
                    elif desc_lines:
                        break
                desc = " ".join(desc_lines)
    if not name:
        name = os.path.basename(os.path.dirname(path)) or "unnamed"
    if not desc:
        h = re.search(r"^#\s+(.+)$", head, re.M)
        desc = h.group(1).strip() if h else ""
    return name, " ".join(desc.split())[:300]


def build_index(progress=None):
    roots = skill_roots()
    files = find_skill_files(roots, progress)
    skills = {}          # content-hash -> entry
    seen_names = {}      # name -> hash (newest mtime wins)
    for i, path in enumerate(files):
        if progress and i % 500 == 0:
            progress(f"parsing {i:,}/{len(files):,} skill files")
        parsed = parse_skill_head(path)
        if not parsed:
            continue
        name, desc = parsed
        try:
            st = os.stat(path)
            with open(path, "rb") as fh:
                digest = hashlib.sha1(fh.read()).hexdigest()[:16]
        except OSError:
            continue
        entry = skills.get(digest)
        if entry:
            entry["copies"] += 1
            if len(path) < len(entry["path"]):
                entry["path"] = path
            continue
        skills[digest] = {"name": name, "desc": desc, "path": path,
                          "mtime": st.st_mtime, "copies": 1}
    # collapse same-name different-content: newest mtime is primary,
    # older variants are kept but suffixed so they stay selectable
    by_name = {}
    for digest, e in skills.items():
        cur = by_name.get(e["name"])
        if cur is None or e["mtime"] > cur["mtime"]:
            by_name[e["name"]] = e
    entries = []
    for e in skills.values():
        primary = by_name[e["name"]] is e
        entries.append({**e, "primary": primary})
    index = {
        "built_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "roots_scanned": len(roots),
        "files_seen": len(files),
        "unique_skills": len(by_name),
        "entries": sorted(entries, key=lambda e: e["name"]),
    }
    global INDEX_PATH
    out_path = index_write_path()
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    tmp = out_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(index, fh)
    os.replace(tmp, out_path)
    if out_path == SHARED_INDEX_PATH:
        # every account must be able to read the shared index
        try:
            os.chmod(out_path, 0o644)
        except OSError:
            pass
    INDEX_PATH = out_path
    return index


def load_index(auto_build=True):
    global INDEX_PATH
    INDEX_PATH = index_read_path()
    try:
        with open(INDEX_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        if not auto_build:
            return None
        live = sys.stderr.isatty()

        def progress(msg):
            if live:
                sys.stderr.write("\r  ◈ " + msg[:70].ljust(72))
                sys.stderr.flush()
        sys.stderr.write("  first run — building the skill index "
                         "(one-time, a few minutes)\n")
        idx = build_index(progress)
        if live:
            sys.stderr.write("\r" + " " * 78 + "\r")
        return idx


