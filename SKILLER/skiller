# ---------------------------------------------------------------- main

def main(argv):
    if any(a in ("-h", "--help", "help") for a in argv):
        return view_help()
    cmd = argv[0].lower() if argv else None
    if cmd == "index":
        return view_index()
    if cmd == "search":
        if len(argv) < 2:
            sys.stderr.write("skiller: search needs a term\n")
            return 2
        return view_search(" ".join(argv[1:]))
    if cmd == "info":
        return view_info()

    opts, words, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--no-copy":
            opts["copy"] = "none"
            i += 1
        elif a == "--think":
            os.environ["SKILLER_THINKING"] = "enabled"
            i += 1
        elif a == "--preview":
            if i + 1 >= len(argv) or not argv[i + 1].isdigit():
                sys.stderr.write("skiller: --preview needs a number\n")
                return 2
            opts["preview"] = int(argv[i + 1])
            i += 2
        else:
            words.append(a)
            i += 1
    query = " ".join(words).strip()
    if not query:
        return view_help()
    return view_fetch(query, opts)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
