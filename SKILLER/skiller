def api_error_frame(exc, inner):
    if isinstance(exc, urllib.error.HTTPError):
        detail = exc.read().decode("utf-8", "replace")[:300]
        return frame(
            [C.warn(" ✘ ") + C.title(f"GLM API error {exc.code}"), ""]
            + [C.dim(l) for l in wrap_block(detail, inner)], title="error")
    return frame([C.warn(" ✘ ") + C.title("Could not reach GLM"),
                  C.dim(str(exc))], title="error")


def view_fetch(query, opts):
    w = term_width()
    inner = w - 6
    cfg = load_config()
    if not cfg["api_key"]:
        print(frame(
            [C.warn(" ✘ ") + C.title("No GLM API key found"),
             "",
             C.key("  export QGLM_API_KEY=") + C.dim("\"your-key\""),
             C.key("  api_key: ") + C.dim("… in ~/.qglm.yaml")],
            title="config"))
        return 1

    print()
    print(hero_block(w))
    print()

    index = load_index()
    n_unique = index.get("unique_skills", len(primary_entries(index)))
    print(frame(
        [stat_line("Ask", query, inner),
         stat_line("Library", f'{n_unique:,} unique skills '
                   f'({index["files_seen"]:,} files scanned)', inner),
         stat_line("Engine", cfg["model"], inner)],
        title="hunt", footer="SKILL-SCOUT is deducing your need"))
    print()

    # ---- stage 1: deduction + selection
    catalog = catalog_for(index, query)
    scout_messages = [
        {"role": "system", "content": SCOUT_SYSTEM},
        {"role": "user", "content":
         catalog + "\n\nUSER REQUEST (may be vague or inadequate):\n"
         + query + "\n\nDeduce the latent need and select skills. "
         "JSON only."},
    ]
    try:
        reply, t1, usage1 = call_glm(cfg, scout_messages, 0.1, 2500,
                                     "deducing")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        print(api_error_frame(exc, inner))
        return 1
    scout = parse_json_reply(reply)
    if not scout or "interpreted_need" not in scout:
        print(frame([C.warn(" ✘ ") +
                     C.title("Scout reply was not parseable")]
                    + [C.dim(l) for l in wrap_block(reply[:400], inner)],
                    title="error"))
        return 1

    picked = resolve_skills(index, scout.get("selected_skills") or [])
    mode = scout.get("mode", "adapt" if picked else "synthesize")
    if not picked:
        mode = "synthesize"

    ded = [C.teal("Interpreted need")]
    ded += [C.body(l) for l in
            wrap_block(scout["interpreted_need"], inner)]
    if scout.get("alternate_reading"):
        ded.append("")
        ded += [C.dim(l) for l in wrap_block(
            "also considered: " + str(scout["alternate_reading"]), inner)]
    ded.append("")
    ded.append(C.teal(f"Sources ({mode})"))
    if picked:
        for e in picked:
            ded.append(C.key("  • " + e["name"]) +
                       C.dim(f'  ({e["copies"]} cop'
                             f'{"y" if e["copies"] == 1 else "ies"})'))
            ded.extend(C.dim("    " + l) for l in
                       wrap_block(e["path"], inner - 4)[:1])
    else:
        ded.append(C.dim("  none fit — writing this skill from scratch"))
    print(frame(ded, title="deduction", footer=f"{t1:.0f}s"))
    print()

    # ---- stage 2: composition
    sources = []
    for e in picked:
        try:
            with open(e["path"], encoding="utf-8", errors="replace") as fh:
                content = fh.read(MAX_SKILL_CHARS)
        except OSError:
            continue
        sources.append(f'<source_skill name="{e["name"]}" '
                       f'path="{e["path"]}">\n{content}\n</source_skill>')
    smith_user = (
        "\n\n".join(sources) +
        ("\n\n" if sources else "") +
        "INTERPRETED NEED:\n" + scout["interpreted_need"] +
        "\n\nORIGINAL REQUEST (for tone/context):\n" + query +
        f"\n\nMODE: {mode}" +
        "\n\nProduce the complete SKILL.md now.")
    smith_messages = [
        {"role": "system", "content": SMITH_SYSTEM},
        {"role": "user", "content": smith_user},
    ]
    try:
        skill_text, t2, usage2 = call_glm(cfg, smith_messages, 0.2, 8000,
                                          "forging")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        print(api_error_frame(exc, inner))
        return 1
    skill_text = strip_fences(skill_text)
    if not skill_text.startswith("---"):
        cut = skill_text.find("---")
        if 0 < cut < 200:
            skill_text = skill_text[cut:]

    nm = re.search(r"^name:\s*(.+)$", skill_text, re.M)
    skill_name = (nm.group(1).strip() if nm else "skill")

    served = usage2.get("_served") or usage1.get("_served")
    engine = (f"{cfg['model']} → {served}"
              if served and served != cfg["model"] else cfg["model"])
    saved = save_history(skill_name, skill_text)
    body = [C.body(l) for l in
            wrap_block(skill_text, inner)[:opts.get("preview", 32)]]
    total_lines = len(skill_text.split("\n"))
    if total_lines > opts.get("preview", 32):
        body.append(C.dim(f"… {total_lines} lines total — full skill is "
                          "on your clipboard"))
    print(frame(body, title=f"skill · {skill_name}",
                footer=f"{engine} · {t1 + t2:.0f}s"))
    print()

    if opts.get("copy") == "none":
        note = C.dim(" copy skipped (--no-copy)")
    elif clipboard_copy(skill_text):
        note = (C.ok(" ✔ ") + C.title("Complete skill copied to clipboard")
                + C.dim("  —  paste into any skills folder"))
    else:
        note = C.warn(" ✘ ") + C.title("Clipboard copy failed")
    tail = [note]
    if saved:
        tail.append(C.dim(f" also saved → {saved}"))
    tail.append(telemetry_line(merge_usage(usage1, usage2),
                               served or cfg["model"]))
    print(frame(tail, footer="skiller --help for more"))
    print()
    return 0


def save_history(name, text):
    try:
        os.makedirs(HISTORY_DIR, exist_ok=True)
        stamp = time.strftime("%Y%m%d-%H%M%S")
        safe = re.sub(r"[^a-z0-9-]", "-", name.lower())[:40]
        path = os.path.join(HISTORY_DIR, f"{stamp}-{safe}.md")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        return tilde(path)
    except OSError:
        return None


def tilde(path):
    """Shorten only this user's home; shared/global paths stay explicit."""
    return path.replace(HOME, "~") if path.startswith(HOME) else path


