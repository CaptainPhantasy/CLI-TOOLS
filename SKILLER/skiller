            os.path.join(SHARED_HOME, "catalog.md"),
            os.path.join(SCRIPT_DIR, "skills-catalog.md"),
        ) if os.path.isfile(p)), ""))
    if override:
        try:
            with open(override, encoding="utf-8") as fh:
                return fh.read()[:120000], override
        except OSError:
            pass
    if not os.path.isdir(CURATED_INDEX_DIR):
        return "", ""
    sections = []
    try:
        cat_files = sorted(
            f for f in os.listdir(CURATED_INDEX_DIR)
            if re.match(r"\d\d-.*\.md$", f) and not f.startswith("00"))
    except OSError:
        return "", ""
    for fname in cat_files:
        try:
            with open(os.path.join(CURATED_INDEX_DIR, fname),
                      encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            continue
        title_m = re.search(r"^#\s+Agent Skills Index\s+—\s+(.+)$",
                            text, re.M)
        title = title_m.group(1) if title_m else fname[3:-3]
        names = re.findall(r"^##\s+(.+)$", text, re.M)
        names = [n.strip() for n in names if not n.lower().startswith(
            ("agent skills", "generated", "notes"))]
        if names:
            sections.append(f"### {title}\n" + ", ".join(names))
    return "\n\n".join(sections), CURATED_INDEX_DIR


def catalog_for(index, query):
    """Catalog in two parts: a STABLE prefix (identical bytes on every
    run, so z.ai's implicit prompt cache serves it at half price) and a
    small query-relevant tail. Query text itself comes last."""
    entries = primary_entries(index)
    curated, _src = curated_catalog()

    def line(e, desc_len):
        return (f'- {e["name"]} — {e["desc"][:desc_len]}' if e["desc"]
                else f'- {e["name"]}')

    # stable prefix: curated categories + deterministic top slice
    # (most-copied first ≈ most-installed, then alphabetical)
    stable_pick = sorted(entries,
                         key=lambda e: (-e.get("copies", 1), e["name"]))
    stable = "\n".join(line(e, 110) for e in
                       sorted(stable_pick[:CATALOG_CAP],
                              key=lambda e: e["name"]))

    # query tail: top matches by keyword affinity, descriptions included
    words = set(re.findall(r"[a-z0-9]{3,}", query.lower()))

    def score(e):
        hay = (e["name"] + " " + e["desc"]).lower()
        return sum(1 for w in words if w in hay)
    relevant = [e for e in sorted(entries,
                                  key=lambda e: (-score(e), e["name"]))
                if score(e) > 0][:150]
    tail = "\n".join(line(e, 140) for e in relevant)

    parts = []
    if curated:
        parts.append("CURATED CATEGORIZED INDEX (category → skill "
                     "names):\n" + curated)
    parts.append("SKILL CATALOG (name — description):\n" + stable)
    if tail:
        parts.append("MOST RELEVANT TO THIS REQUEST (name — "
                     "description):\n" + tail)
    return "\n\n".join(parts)


def resolve_skills(index, names):
    """Map SKILL-SCOUT's chosen names to index entries."""
    entries = index["entries"]
    primaries = {e["name"]: e for e in entries if e.get("primary")}
    out = []
    for n in names[:MAX_SELECTED]:
        e = primaries.get(n)
        if e is None:
            low = n.lower()
            cands = [x for x in entries
                     if x.get("primary") and low in x["name"].lower()]
            e = min(cands, key=lambda x: len(x["name"])) if cands else None
        if e and e not in out:
            out.append(e)
    return out


# ---------------------------------------------------------------- clipboard

def clipboard_copy(text: str) -> bool:
    try:
        proc = subprocess.run(["pbcopy"], input=text.encode("utf-8"),
                              timeout=10)
        return proc.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


# ---------------------------------------------------------------- GLM call

def call_glm(cfg, messages, temperature, max_tokens, label):
    payload = {
        "model": cfg["model"],
        "messages": messages,
        "temperature": temperature,
        "top_p": 0.9,
        "max_tokens": max_tokens,
        "stream": True,
        # GLM-4.5 thinking phase costs ~50s per call for little gain on
        # catalog matching; measured 55.6s -> 2.3s on this endpoint
        "thinking": {"type": cfg.get("thinking", "disabled")},
    }
    req = urllib.request.Request(
        cfg["endpoint"],
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json",
                 "Authorization": f"Bearer {cfg['api_key']}"})
    chunks = []
    usage = {}
    served = None
    start = time.time()
    last_draw = 0.0
    spinner = "◢◣◤◥"
    live = sys.stderr.isatty()
    try:
        with urllib.request.urlopen(req, timeout=cfg["timeout"]) as resp:
            for i, raw in enumerate(resp):
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    obj = json.loads(data)
                    delta = obj["choices"][0].get("delta", {})
                except (json.JSONDecodeError, KeyError, IndexError):
                    continue
                if obj.get("usage"):
                    usage = obj["usage"]
                if obj.get("model"):
                    served = obj["model"]
                content = delta.get("content") or ""
                if content:
                    chunks.append(content)
                now = time.time()
                if live and now - last_draw >= 0.15:
                    last_draw = now
                    n = sum(len(c) for c in chunks)
                    sys.stderr.write(
                        f"\r  {spinner[i % 4]} {label}… "
                        f"{n:,} chars · {now - start:.0f}s ")
                    sys.stderr.flush()
    finally:
        if live:
            sys.stderr.write("\r" + " " * 70 + "\r")
            sys.stderr.flush()
    if served:
        usage["_served"] = served
    return "".join(chunks), time.time() - start, usage


def merge_usage(*usages):
    """Sum token usage across calls into one telemetry dict."""
    tot = {"prompt": 0, "cached": 0, "out": 0, "cache_supported": False}
    for u in usages:
        if not u:
            continue
        tot["prompt"] += u.get("prompt_tokens", 0)
        det = u.get("prompt_tokens_details")
        if det is not None:
            tot["cache_supported"] = True
            tot["cached"] += det.get("cached_tokens", 0)
        tot["out"] += u.get("completion_tokens", 0)
    return tot


def telemetry_line(tot, model=""):
    """One-line cache/token telemetry with real z.ai pricing."""
    if not tot["prompt"]:
        return C.dim(" telemetry unavailable (no usage in stream)")
    pct = 100.0 * tot["cached"] / tot["prompt"]
    price = PRICING.get(model.lower())
    if tot["cached"]:
        cache_part = C.ok(f'{tot["cached"]:,} cached ({pct:.0f}%)')
    elif tot["cache_supported"]:
        cache_part = C.dim("0 cached (cold)")
    else:
        cache_part = C.dim("cache n/a for this model")
    if price and price[0] == 0.0:
        note = "  →  free tier ✦"
    elif price and tot["cached"] and price[1] is not None:
        full = tot["prompt"] * price[0] + tot["out"] * price[2]
        real = ((tot["prompt"] - tot["cached"]) * price[0]
                + tot["cached"] * price[1] + tot["out"] * price[2])
        note = (f'  →  ${real / 1e6:.4f} '
                f'(cache saved {100 * (1 - real / full):.0f}%)')
    elif price:
        cost = tot["prompt"] * price[0] + tot["out"] * price[2]
        note = f'  →  ${cost / 1e6:.4f}'
    else:
        note = ""
    return (C.dim(" tokens  ") + C.body(f'{tot["prompt"]:,} in') +
            C.dim(" · ") + cache_part +
            C.dim(" · ") + C.body(f'{tot["out"]:,} out') + C.dim(note))


def parse_json_reply(text):
    cleaned = text.strip()
    m = re.search(r"```(?:json)?\s*(.*?)```", cleaned, re.S)
    if m:
        cleaned = m.group(1).strip()
    start = cleaned.find("{")
    if start == -1:
        return None
    for end in range(len(cleaned), start, -1):
        try:
            obj = json.loads(cleaned[start:end])
            return obj if isinstance(obj, dict) else None
        except json.JSONDecodeError:
            continue
    return None


def strip_fences(text):
    t = text.strip()
    m = re.match(r"^```[a-zA-Z]*\s*\n(.*)\n```$", t, re.S)
    return m.group(1).strip() if m else t


