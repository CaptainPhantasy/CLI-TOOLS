def _writable(path):
    """True if we could create/replace `path` (checks nearest parent)."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    while d and not os.path.isdir(d):
        d = os.path.dirname(d)
    return bool(d) and os.access(d, os.W_OK)


def index_read_path():
    """Newest readable index: shared wins unless a user one is fresher."""
    cands = [p for p in (SHARED_INDEX_PATH, USER_INDEX_PATH)
             if os.path.isfile(p)]
    if not cands:
        return SHARED_INDEX_PATH
    if len(cands) == 1:
        return cands[0]
    return max(cands, key=lambda p: os.path.getmtime(p))


def index_write_path():
    """Write shared when permitted, else fall back to this user's dir."""
    if _writable(SHARED_INDEX_PATH):
        return SHARED_INDEX_PATH
    return USER_INDEX_PATH


