def view_search(term):
    w = term_width()
    inner = w - 6
    index = load_index()
    words = [t for t in re.findall(r"[a-z0-9]{2,}", term.lower())]
    hits = []
    for e in primary_entries(index):
        hay = (e["name"] + " " + e["desc"]).lower()
        s = sum(1 for t in words if t in hay)
        if s:
            hits.append((s, e))
    hits.sort(key=lambda x: (-x[0], x[1]["name"]))
    lines = []
    for s, e in hits[:25]:
        lines.append(C.key(e["name"]))
        if e["desc"]:
            lines.extend(C.dim("  " + l) for l in
                         wrap_block(e["desc"][:160], inner - 2)[:2])
        lines.append(C.dim("  " + tilde(e["path"])))
    if not lines:
        lines = [C.dim("no local matches — try `skiller \"" + term +
                       "\"` and let SKILL-SCOUT deduce it")]
    print()
    print(frame(lines, title=f"search · {term}",
                footer=f"{len(hits)} matches"))
    print()
    return 0


