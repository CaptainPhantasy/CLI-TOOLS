#!/usr/bin/env python3
"""KEYRING — find every credential on this machine, without ever showing one.

Sweeps your harness dot-directories, shell profiles and project env files
for API keys and tokens, then reports WHERE each secret lives, WHICH ones
have been copied to more than one place, and WHICH are exposed by weak
file permissions.

    keyring                    sweep and report
    keyring --dupes            only secrets living in 2+ places
    keyring --exposed          only world/group-readable secrets
    keyring --provider z.ai    filter to one provider
    keyring explain            GLM advises on rotation order
    keyring --json             machine-readable (still no values)
    keyring --help             usage

SAFETY, by construction:
  * A secret's VALUE is never printed, never logged, never written to the
    clipboard, and never sent to the model. Only a salted fingerprint.
  * The fingerprint is HMAC-SHA256 over the secret using a per-machine
    salt stored 0600. It is stable across runs so duplicates can be
    matched, but it is not reversible into the secret.
  * Read-only. KEYRING never edits, moves, or deletes a file.

Zero dependencies. Config shared with qglm (~/.qglm.yaml / QGLM_API_KEY).
"""

import argparse
import base64
import hashlib
import hmac
import json
import os
import re
import stat
import sys
import time

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from clikit import (C, call_glm, clipboard_copy, frame, hero_block,  # noqa: E402
                    human_age, load_config, merge_usage, stat_line,
                    telemetry_line, term_width, tilde, user_homes,
                    wrap_block)

HERO = r"""
 █  █  ▄▀▀▀▀▀▄  █  █  █▀▀▀▀▀▄  █▀▀▀▀▀▄  █  █  █▄  █  ▄▀▀▀▀▀▄
 █▄▄▀   █▄▄▄▄▄  ▀▄▄▀  █▄▄▄▄▄▀  █  ▄▄▄█  █  █  █ ▀▄█  █     ▀
 █  █   █          █  █    ▀▄  █  ▀█    █  █  █   █  █  ▀▀█
 █  █   ▀▄▄▄▄▄     █  █     █  █   ▀█▄  █  █  █   █  ▀▄▄▄▄▀
""".strip("\n")

# gold ramp: keys
RAMP = (229, 223, 221, 215)

TAGLINE = "every secret · where it lives · never what it is"

# Files worth reading. Anything bigger than this is not a config file.
MAX_FILE = 512 * 1024

CONFIG_NAMES = re.compile(
    r"^(\.?env(\.[\w.-]+)?|.*\.env|config\.(json|yaml|yml|toml)|"
    r"credentials(\.json)?|auth\.json|settings\.json|secrets\.(json|yaml|yml)|"
    r"\.qglm\.yaml|\.netrc|\.npmrc|\.pypirc|mcp\.json|\.mcp\.json|"
    r"[\w.-]*\.(cfg|ini|conf))$", re.I)

SHELL_PROFILES = (".zshrc", ".bashrc", ".bash_profile", ".profile",
                  ".zshenv", ".zprofile")

SKIP_DIRS = {
    "node_modules", ".venv", "venv", "__pycache__", ".next", "dist",
    "build", "target", "vendor", "Pods", ".gradle", ".pnpm-store",
    ".Trash", "Caches", ".terraform", "site-packages", ".mypy_cache",
    # Large, machine-generated, and never the source of truth for a
    # credential. Without these the sweep spends minutes in caches.
    ".git", "Library", "Applications", ".rustup", ".cargo", ".nvm",
    ".bun", ".deno", ".npm", ".pyenv", ".rbenv", ".docker", "go",
    ".android", ".gem", ".cocoapods", "Photos Library.photoslibrary",
    ".local", "logs", "log", "tmp", ".tmp", "snapshots", "history",
    ".swiftpm", ".m2", "Downloads", "Movies", "Music", "Pictures",
}

# Bound the walk. Credentials live in config files near the top of a
# project or dot-directory, not 12 levels deep in a build tree.
MAX_DEPTH = 6

# Provider signatures. Ordered: first match wins, so specific patterns
# must precede the generic catch-alls.
#
# Each entry: (provider, compiled regex). The regex must capture the
# secret itself in group 'v' so we can fingerprint it without echoing it.
PATTERNS = [
    ("openai",     r"\b(?P<v>sk-proj-[A-Za-z0-9_-]{20,})"),
    ("openai",     r"\b(?P<v>sk-[A-Za-z0-9]{32,})"),
    ("anthropic",  r"\b(?P<v>sk-ant-[A-Za-z0-9_-]{32,})"),
    ("github",     r"\b(?P<v>gh[pousr]_[A-Za-z0-9]{36,})"),
    ("github",     r"\b(?P<v>github_pat_[A-Za-z0-9_]{40,})"),
    ("slack",      r"\b(?P<v>xox[baprs]-[A-Za-z0-9-]{10,})"),
    ("google",     r"\b(?P<v>AIza[A-Za-z0-9_-]{35})"),
    ("aws",        r"\b(?P<v>AKIA[0-9A-Z]{16})\b"),
    ("stripe",     r"\b(?P<v>[sr]k_(live|test)_[A-Za-z0-9]{20,})"),
    ("gitlab",     r"\b(?P<v>glpat-[A-Za-z0-9_-]{20,})"),
    ("hugging",    r"\b(?P<v>hf_[A-Za-z0-9]{30,})"),
    ("groq",       r"\b(?P<v>gsk_[A-Za-z0-9]{40,})"),
    ("z.ai",       r"\b(?P<v>[0-9a-f]{32}\.[A-Za-z0-9]{16})\b"),
    ("openrouter", r"\b(?P<v>sk-or-v1-[0-9a-f]{48,})"),
    ("replicate",  r"\b(?P<v>r8_[A-Za-z0-9]{35,})"),
    ("tavily",     r"\b(?P<v>tvly-[A-Za-z0-9_-]{20,})"),
    ("private-key", r"(?P<v>-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----)"),
    # Generic assignment: KEY=..., "api_key": "...", api-key: ...
    ("generic",
     r"(?i)\b(api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|"
     r"client[_-]?secret|password|passwd|bearer)\b\s*[:=]\s*"
     r"['\"]?(?P<v>[A-Za-z0-9_\-./+=]{20,})['\"]?"),
]
COMPILED = [(name, re.compile(pat)) for name, pat in PATTERNS]

# Values that match the shapes above but are obviously not secrets.
PLACEHOLDER = re.compile(
    r"(?i)^(x{4,}|y{4,}|0{6,}|1{6,}|<[^>]+>|\$\{?[A-Z_]+\}?|"
    r"your[_-]?\w*|my[_-]?\w*|example\w*|changeme\w*|placeholder\w*|"
    r"insert\w*|todo\w*|none|null|true|false|test|dummy\w*|sample\w*|"
    r"redacted\w*|removed\w*|\.\.\.+|\*{4,})$")


# ---------------------------------------------------------------- fingerprint

def machine_salt():
    """Per-machine salt so fingerprints can't be compared across hosts or
    reversed with a precomputed table. Stored 0600 in the user's home."""
    path = os.path.join(os.path.expanduser("~"), ".keyring-salt")
    try:
        with open(path, "rb") as fh:
            data = fh.read().strip()
            if len(data) >= 16:
                return data
    except OSError:
        pass
    salt = base64.b64encode(os.urandom(32))
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(salt)
    except OSError:
        pass
    return salt


SALT = machine_salt()


def fingerprint(secret: str) -> str:
    """Short, stable, non-reversible identifier for a secret value.

    HMAC rather than a bare hash so that knowing the digest and guessing
    a candidate value is not enough without the machine salt."""
    mac = hmac.new(SALT, secret.encode("utf-8", "replace"), hashlib.sha256)
    return mac.hexdigest()[:12]


def redact(secret: str) -> str:
    """A hint at identity for the human, never enough to authenticate.

    Shows at most the first 3 characters, which for real keys is the
    provider prefix that is already public knowledge (sk-, ghp-, AKIA)."""
    head = secret[:3] if len(secret) > 12 else ""
    return f"{head}…" if head else "…"


# ---------------------------------------------------------------- scanning

def candidate_files(roots, progress=None):
    files = []
    for root in roots:
        if not os.path.isdir(root):
            continue
        base_depth = root.rstrip("/").count(os.sep)
        for dirpath, dirnames, filenames in os.walk(
                root, onerror=lambda e: None):
            if dirpath.count(os.sep) - base_depth >= MAX_DEPTH:
                dirnames[:] = []
                continue
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for fn in filenames:
                if CONFIG_NAMES.match(fn) or fn in SHELL_PROFILES:
                    p = os.path.join(dirpath, fn)
                    try:
                        if os.path.getsize(p) <= MAX_FILE:
                            files.append(p)
                    except OSError:
                        continue
            if progress and len(files) % 200 == 0 and files:
                progress(f"{len(files):,} config files · {tilde(dirpath)}")
    return files


def scan_file(path):
    """Extract findings from one file. Returns list of dicts, no values."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            text = fh.read(MAX_FILE)
    except OSError:
        return []
    try:
        st = os.stat(path)
    except OSError:
        return []

    mode = stat.S_IMODE(st.st_mode)
    world = bool(mode & stat.S_IROTH)
    group = bool(mode & stat.S_IRGRP)

    out = []
    seen = set()
    for lineno, line in enumerate(text.split("\n"), 1):
        if len(line) > 4000:
            continue
        stripped = line.lstrip()
        # Skip comments so documented examples don't inflate the count.
        if stripped.startswith(("#", "//", ";", "*")):
            continue
        for provider, rx in COMPILED:
            m = rx.search(line)
            if not m:
                continue
            val = m.group("v")
            if not val or PLACEHOLDER.match(val):
                continue
            fp = fingerprint(val)
            if fp in seen:
                break
            seen.add(fp)
            out.append({
                "path": path,
                "line": lineno,
                "provider": provider,
                "fp": fp,
                "hint": redact(val),
                "length": len(val),
                "mode": oct(mode),
                "world_readable": world,
                "group_readable": group,
                "mtime": st.st_mtime,
            })
            break  # first matching provider wins for this line
    return out


def sweep(roots, progress=None):
    files = candidate_files(roots, progress)
    findings = []
    for i, p in enumerate(files):
        if progress and i % 50 == 0:
            progress(f"reading {i:,}/{len(files):,} · {tilde(p)}")
        findings.extend(scan_file(p))
    return findings, len(files)


# ---------------------------------------------------------------- analysis

def group_by_secret(findings):
    """Cluster findings by fingerprint: one entry per distinct secret."""
    groups = {}
    for f in findings:
        g = groups.setdefault(f["fp"], {
            "fp": f["fp"], "provider": f["provider"], "hint": f["hint"],
            "length": f["length"], "locations": [],
        })
        g["locations"].append(f)
    for g in groups.values():
        g["copies"] = len(g["locations"])
        g["exposed"] = any(l["world_readable"] for l in g["locations"])
        g["group_exposed"] = any(l["group_readable"] for l in g["locations"])
        g["newest"] = max(l["mtime"] for l in g["locations"])
        g["_score"] = secret_risk(g)
    return sorted(groups.values(), key=lambda g: -g["_score"])


def secret_risk(g):
    """Rank by blast radius, not by provider prestige.

    A secret in many places is harder to rotate and more likely to leak
    through one of them. World-readable is the only unconditional
    emergency, because any process on the box can read it."""
    score = 0.0
    score += (g["copies"] - 1) * 15.0     # each extra copy widens exposure
    if g["exposed"]:
        score += 60.0                     # world-readable
    if g["group_exposed"]:
        score += 15.0
    if g["provider"] == "private-key":
        score += 25.0
    if g["provider"] != "generic":
        score += 10.0                     # confidently a real credential
    return score


def band(score):
    if score >= 60:
        return C.bad("EXPOSED ")
    if score >= 30:
        return C.warn("SPREAD  ")
    if score >= 10:
        return C.key("TRACKED ")
    return C.dim("SINGLE  ")


# ---------------------------------------------------------------- rendering

def render(groups, w, show):
    inner = w - 6
    now = time.time()
    lines = []
    if not groups:
        lines.append(C.ok("  no credentials found in the scanned locations"))
    for g in groups:
        flags = []
        if g["exposed"]:
            flags.append(C.bad("world-readable"))
        elif g["group_exposed"]:
            flags.append(C.warn("group-readable"))
        if g["copies"] > 1:
            flags.append(C.warn(f'{g["copies"]} copies'))
        head = (band(g["_score"]) + "  " +
                C.body(f'{g["provider"]:<12}') +
                C.dim(f'{g["hint"]:<5} {g["length"]}ch  ') +
                ("  ".join(flags) if flags else C.dim("single location")))
        lines.append(head)
        for loc in sorted(g["locations"], key=lambda l: l["path"])[:6]:
            perm = loc["mode"][-3:]
            mark = (C.bad(" ← world-readable") if loc["world_readable"]
                    else "")
            lines.append(C.dim(f'     {tilde(loc["path"])}:{loc["line"]} '
                               f'[{perm}]') + mark)
        if g["copies"] > 6:
            lines.append(C.dim(f'     … {g["copies"] - 6} more'))
    return frame(lines, title=f"keyring · {show}",
                 footer=f"{len(groups)} distinct secrets", width=w)


# ---------------------------------------------------------------- GLM advice

ADVICE_SYSTEM = """You are KEYRING-ADVISOR, a pragmatic security engineer.

You are given an inventory of credentials found on one developer machine. \
You are given ONLY: provider name, a non-reversible fingerprint, how many \
places each secret lives, file paths, and file permissions. You are NEVER \
given secret values and must never ask for them.

Advise on:
- Which secrets to rotate FIRST, by blast radius, not by provider fame.
- Which duplicates should collapse to a single source of truth, and where \
that source should live.
- Which file permissions to tighten, with the exact chmod.
- What structural change would stop this recurring (env var indirection, \
a secrets manager, per-tool scoped keys).

Rules:
- Never speculate about a secret's value.
- Be concrete: name paths, give commands.
- World-readable credentials are the emergency. Say so plainly.
- At most 8 bullets, then one closing line.
"""


def advise(groups, cfg):
    if not groups:
        return "No credentials found. Nothing to advise on.", {}
    rows = []
    for g in groups[:30]:
        paths = ", ".join(tilde(l["path"]) for l in g["locations"][:5])
        rows.append(
            f'{g["provider"]} fp={g["fp"]} copies={g["copies"]} '
            f'world_readable={g["exposed"]} paths=[{paths}]')
    user = ("Credential inventory from this machine (values withheld by "
            "design):\n\n" + "\n".join(rows) +
            "\n\nWhat should I rotate or fix first, and how?")
    text, _, usage = call_glm(
        cfg,
        [{"role": "system", "content": ADVICE_SYSTEM},
         {"role": "user", "content": user}],
        temperature=0.2, max_tokens=1200, label="advising")
    return text.strip(), usage


# ---------------------------------------------------------------- views

def view_help():
    w = term_width()
    print()
    print(hero_block(HERO, TAGLINE, RAMP, w))
    print()
    lines = [
        C.key("keyring") + C.dim("                   sweep and report"),
        C.key("keyring --dupes") + C.dim("           secrets in 2+ places"),
        C.key("keyring --exposed") + C.dim("         world/group-readable only"),
        C.key("keyring --provider z.ai") + C.dim("   filter to one provider"),
        C.key("keyring explain") + C.dim("           GLM advises rotation order"),
        C.key("keyring --json") + C.dim("            machine-readable output"),
        "",
        C.ok("Safety:"),
        C.dim("  Secret values are never printed, copied, logged, or sent"),
        C.dim("  to the model. Only a salted HMAC fingerprint is used, so"),
        C.dim("  duplicates can be matched without exposing anything."),
        C.dim("  Read-only: never edits, moves or deletes a file."),
    ]
    print(frame(lines, title="keyring · usage", width=w))
    print()
    return 0


def main(argv):
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("command", nargs="?", default="sweep")
    ap.add_argument("--dupes", action="store_true")
    ap.add_argument("--exposed", action="store_true")
    ap.add_argument("--provider", default="")
    ap.add_argument("--roots", default="")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)

    if args.help or args.command in ("help", "--help"):
        return view_help()

    roots = ([r for r in args.roots.split(":") if r] if args.roots
             else user_homes())

    w = term_width()
    if not args.json:
        print()
        print(hero_block(HERO, TAGLINE, RAMP, w))
        print()

    live = sys.stderr.isatty() and not args.json

    def progress(msg):
        if live:
            sys.stderr.write("\r  ◈ " + msg[:70].ljust(72))
            sys.stderr.flush()

    start = time.time()
    findings, nfiles = sweep(roots, progress)
    if live:
        sys.stderr.write("\r" + " " * 78 + "\r")

    groups = group_by_secret(findings)

    show = "all secrets"
    if args.dupes:
        groups = [g for g in groups if g["copies"] > 1]
        show = "duplicated secrets"
    if args.exposed:
        groups = [g for g in groups if g["exposed"] or g["group_exposed"]]
        show = "exposed secrets"
    if args.provider:
        groups = [g for g in groups
                  if args.provider.lower() in g["provider"].lower()]
        show = f"provider · {args.provider}"

    if args.json:
        # Values are absent from the data structure by construction.
        print(json.dumps({"secrets": groups, "files_scanned": nfiles},
                         indent=2, default=str))
        return 0

    print(render(groups, w, show))
    print()

    inner = w - 6
    exposed = sum(1 for g in groups if g["exposed"])
    dupes = sum(1 for g in groups if g["copies"] > 1)
    print(frame([
        stat_line("Scanned", f"{nfiles:,} config files in "
                  f"{time.time() - start:.0f}s", inner),
        stat_line("Secrets", f"{len(groups):,} distinct", inner),
        stat_line("Duplicated", f"{dupes:,} live in more than one file",
                  inner),
        stat_line("Exposed", f"{exposed:,} world-readable", inner),
    ], title="summary", width=w))
    print()

    if exposed:
        print(frame([C.bad(f"  {exposed} credential(s) are readable by every "
                           "process on this machine."),
                     C.dim("  Fix with: chmod 600 <path>")],
                    title="act on this", width=w))
        print()

    if args.command == "explain":
        cfg = load_config("KEYRING_MODEL")
        if not cfg["api_key"]:
            print(frame([C.warn("no API key — set QGLM_API_KEY or write "
                                "~/.qglm.yaml")], title="explain", width=w))
            print()
            return 1
        text, usage = advise(groups, cfg)
        lines = []
        for ln in text.split("\n"):
            lines.extend(wrap_block(ln, inner) if ln.strip() else [""])
        print(frame(lines, title="advice · rotation order", width=w))
        print(telemetry_line(merge_usage(usage), cfg["model"]))
        print()
        # Advice contains no secret values, so it is safe to copy.
        if clipboard_copy(text):
            print(C.ok("  ✓ advice copied to clipboard (no secrets in it)"))
            print()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.stderr.write("\n  interrupted\n")
        sys.exit(130)
