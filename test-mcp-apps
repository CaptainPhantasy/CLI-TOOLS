#!/usr/bin/env python3
"""test-mcp-apps — full verification of the three MCP Apps servers.

Checks, in order of what would hurt most if broken:

  1. SECURITY   no secret value reaches any model-visible surface
  2. SECURITY   app-only tools are absent from tools/list
  3. SECURITY   write tools reject inputs outside their remit
  4. PROTOCOL   initialize / tools/list / resources/read conform to SEP-1865
  5. PROTOCOL   servers degrade to text-only when the host lacks the extension
  6. BEHAVIOUR  each view renders real data in a simulated host

Run: ./test-mcp-apps
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import shutil
import selectors
import time

TOOLS = os.path.dirname(os.path.realpath(__file__))
UI_EXT = "io.modelcontextprotocol/ui"
UI_MIME = "text/html;profile=mcp-app"

MODERN = "2026-07-28"
M_VER = "io.modelcontextprotocol/protocolVersion"
M_CAPS = "io.modelcontextprotocol/clientCapabilities"
M_INFO = "io.modelcontextprotocol/clientInfo"
M_SRV = "io.modelcontextprotocol/serverInfo"


def modern_meta(ui=True):
    caps = {"extensions": {UI_EXT: {"mimeTypes": [UI_MIME]}}} if ui else {}
    return {M_VER: MODERN, M_CAPS: caps,
            M_INFO: {"name": "test", "version": "1"}}

